
/**
 * Capstone Project: Make the Computer Draw a Box
 * Student: Yuvraj Singh Soni
 * Roll No: 2501010098
 *
 * Part A: Hack CPU Implementation
 *
 * Implements the Hack CPU according to the Nand2Tetris
 * Hack machine language specification.
 */

CHIP CPU {

    IN  inM[16],          // Memory input
        instruction[16],  // Current instruction
        reset;             // PC reset signal

    OUT outM[16],         // ALU result / memory output
        writeM,            // Memory write enable
        addressM[15],      // Memory address
        pc[15];            // Program counter output

    PARTS:

    // -------------------------------------------------
    // 1. Instruction decoding
    // -------------------------------------------------

    // A-instruction: instruction[15] = 0
    // C-instruction: instruction[15] = 1
    Not(
        in=instruction[15],
        out=isAInst
    );

    // -------------------------------------------------
    // 2. A-register input selection
    // -------------------------------------------------

    // A-instruction loads instruction value.
    // C-instruction loads ALU output when destination A is selected.
    Mux16(
        a=aluOut,
        b=instruction,
        sel=isAInst,
        out=aRegIn
    );

    // Load A-register for:
    // A-instruction OR C-instruction with destination bit d1 = 1.
    Or(
        a=isAInst,
        b=instruction[5],
        out=loadA
    );

    ARegister(
        in=aRegIn,
        load=loadA,
        out=aOut,
        out[0..14]=addressM
    );

    // -------------------------------------------------
    // 3. D-register control
    // -------------------------------------------------

    // Load D-register only for C-instructions
    // with destination bit d2 = 1.
    And(
        a=instruction[15],
        b=instruction[4],
        out=loadD
    );

    DRegister(
        in=aluOut,
        load=loadD,
        out=dOut
    );

    // -------------------------------------------------
    // 4. ALU input selection
    // -------------------------------------------------

    // Select memory input when the C-instruction
    // uses M as its ALU operand (a-bit = 1).
    And(
        a=instruction[15],
        b=instruction[12],
        out=selAM
    );

    Mux16(
        a=aOut,
        b=inM,
        sel=selAM,
        out=amOut
    );

    // -------------------------------------------------
    // 5. Arithmetic Logic Unit
    // -------------------------------------------------

    // ALU control bits:
    // zx = instruction[11]
    // nx = instruction[10]
    // zy = instruction[9]
    // ny = instruction[8]
    // f  = instruction[7]
    // no = instruction[6]

    // ALU output is connected to outM only once.
    ALU(
        x=dOut,
        y=amOut,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // -------------------------------------------------
    // 6. Memory write control
    // -------------------------------------------------

    // Enable memory writing only when:
    // C-instruction AND destination bit d3 = 1.
    And(
        a=instruction[15],
        b=instruction[3],
        out=writeM
    );

    // -------------------------------------------------
    // 7. Jump condition evaluation
    // -------------------------------------------------

    // Negative result: ALU output < 0
    And(
        a=instruction[2],
        b=ng,
        out=jlt
    );

    // Zero result: ALU output = 0
    And(
        a=instruction[1],
        b=zr,
        out=jeq
    );

    // Positive result: ALU output > 0
    // A result is positive when neither zero nor negative.
    Or(
        a=zr,
        b=ng,
        out=zrOrNg
    );

    Not(
        in=zrOrNg,
        out=pos
    );

    And(
        a=instruction[0],
        b=pos,
        out=jgt
    );

    // Combine all three jump conditions.
    Or(
        a=jlt,
        b=jeq,
        out=jumpLE
    );

    Or(
        a=jumpLE,
        b=jgt,
        out=jumpCond
    );

    // -------------------------------------------------
    // 8. Program Counter control
    // -------------------------------------------------

    // A jump is allowed only for a C-instruction
    // whose selected jump condition is satisfied.
    And(
        a=instruction[15],
        b=jumpCond,
        out=pcLoad
    );

    // Increment PC when no jump is selected.
    Not(
        in=pcLoad,
        out=pcInc
    );

    // PC reset has priority over load and increment.
    PC(
        in=aOut,
        load=pcLoad,
        inc=pcInc,
        reset=reset,
        out[0..14]=pc
    );
}
